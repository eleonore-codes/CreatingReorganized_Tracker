<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>CreatingReorganized — Side-Hustle Hero's Journey</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet"/>
<style>
:root{
  --blue:#1558A8;--blue-dk:#0B3D7A;--blue-md:#2A7DD4;--blue-lt:#EAF2FB;--blue-x:#D1E6F7;
  --yel:#F5C416;--yel-dk:#C99E00;--yel-lt:#FFFBE6;--yel-md:#EAB800;
  --surf:#FFFFFF;--bg:#F3F6FB;--bdr:#D5E2F0;--txt:#16243A;--mute:#5A6E88;
  --green:#1B8A4A;--green-lt:#E5F7ED;--red:#C0392B;--red-lt:#FDECEA;
  --purple:#5D3FD3;--purple-lt:#F0EBFF;
  --r:12px;--r-sm:8px;--sh:0 2px 14px rgba(13,45,90,.10);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--txt);min-height:100vh;font-size:15px;}
h2,h3{font-family:'Syne',sans-serif;}
a{color:var(--blue);}a:hover{text-decoration:underline;}
button,input,textarea,select{font-family:'DM Sans',sans-serif;cursor:pointer;}
::-webkit-scrollbar{width:5px;height:5px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:var(--bdr);border-radius:3px;}

/* ── HEADER ── */
.hdr{background:var(--blue-dk);color:#fff;padding:.8rem 1.2rem;display:flex;align-items:center;
  justify-content:space-between;position:sticky;top:0;z-index:200;box-shadow:0 2px 10px rgba(0,0,0,.28);}
.cr-logo{background:var(--yel);color:var(--blue-dk);font-family:'Syne',sans-serif;font-weight:800;
  font-size:10px;padding:3px 7px;border-radius:5px;letter-spacing:.6px;}
.hdr-title{font-size:.93rem;font-weight:700;letter-spacing:.3px;display:flex;align-items:center;gap:8px;}
.hdr-sub{font-size:.66rem;color:rgba(255,255,255,.5);margin-top:2px;}
.hdr-right{display:flex;align-items:center;gap:.5rem;}
.crbtn{background:var(--yel);color:var(--blue-dk);border:none;padding:.38rem .88rem;border-radius:7px;
  font-size:.76rem;font-weight:700;transition:all .18s;letter-spacing:.3px;}
.crbtn:hover{background:var(--yel-dk);color:#fff;}
.settbtn{background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.28);color:#fff;
  padding:.38rem .75rem;border-radius:7px;font-size:.76rem;font-weight:600;transition:all .18s;}
.settbtn:hover{background:rgba(255,255,255,.24);}

/* ── TABS ── */
.tabs{background:var(--blue-dk);display:flex;padding:0 .8rem;overflow-x:auto;
  border-top:1px solid rgba(255,255,255,.08);}
.tabs::-webkit-scrollbar{height:0;}
.tab{padding:.55rem .9rem;font-size:.77rem;font-weight:600;color:rgba(255,255,255,.52);
  cursor:pointer;border-bottom:3px solid transparent;transition:all .18s;white-space:nowrap;}
.tab.active{color:#fff;border-bottom-color:var(--yel);}
.tab:hover:not(.active){color:rgba(255,255,255,.82);}

/* ── LAYOUT ── */
.wrap{max-width:1080px;margin:0 auto;padding:1.2rem 1rem;}
.panel{display:none;}.panel.active{display:block;}

/* ── HERO ── */
.hero{background:linear-gradient(135deg,var(--blue-dk) 0%,var(--blue) 100%);border-radius:var(--r);
  padding:1.2rem;color:#fff;display:grid;grid-template-columns:auto 1fr auto;gap:1.1rem;
  align-items:center;margin-bottom:1.1rem;}
@media(max-width:540px){.hero{grid-template-columns:auto 1fr;}.lbadge{display:none;}}
.av-wrap{display:flex;flex-direction:column;align-items:center;gap:.38rem;}
.av-name{background:var(--yel);color:var(--blue-dk);font-weight:700;font-size:.66rem;
  padding:2px 7px;border-radius:5px;text-align:center;letter-spacing:.3px;}
.xp-lbl{font-size:.68rem;color:rgba(255,255,255,.6);display:flex;justify-content:space-between;margin-bottom:3px;}
.xp-t{height:6px;background:rgba(255,255,255,.2);border-radius:3px;overflow:hidden;}
.xp-f{height:100%;background:var(--yel);border-radius:3px;transition:width .5s ease;}
.lbadge{background:var(--yel);color:var(--blue-dk);width:54px;height:54px;border-radius:50%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;}
.lbadge .n{font-family:'Syne',sans-serif;font-size:1.45rem;font-weight:800;line-height:1;}
.lbadge .t{font-size:.5rem;font-weight:700;letter-spacing:.5px;}

/* ── MENTOR ── */
.mentor{background:var(--yel-lt);border:1.5px solid var(--yel-md);border-radius:var(--r);
  padding:.9rem 1.1rem;margin-bottom:1.1rem;display:flex;gap:.85rem;align-items:flex-start;}
.m-av{width:40px;height:40px;flex-shrink:0;border-radius:50%;background:var(--blue-dk);
  display:flex;align-items:center;justify-content:center;color:#fff;
  font-family:'Syne',sans-serif;font-weight:800;font-size:.85rem;}
.m-lbl{font-size:.66rem;font-weight:700;color:var(--yel-dk);text-transform:uppercase;letter-spacing:.5px;margin-bottom:.18rem;}
#mentorQ{font-size:.82rem;color:var(--txt);line-height:1.52;font-style:italic;}

/* ── SECTION TITLE ── */
.sec{font-size:.88rem;font-weight:700;color:var(--txt);margin-bottom:.78rem;
  display:flex;align-items:center;gap:.45rem;}
.sec::before{content:'';display:inline-block;width:4px;height:15px;background:var(--yel);
  border-radius:2px;flex-shrink:0;}

/* ── LEVEL CARDS ── */
.lvls{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.68rem;margin-bottom:1.1rem;}
.lc{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);
  padding:.85rem;cursor:pointer;transition:all .18s;position:relative;}
.lc:hover:not(.locked){border-color:var(--blue-md);transform:translateY(-2px);box-shadow:var(--sh);}
.lc.active{border-color:var(--blue);background:var(--blue-lt);}
.lc.done::after{content:'✓';position:absolute;top:7px;right:8px;color:var(--green);font-weight:800;font-size:.82rem;}
.lc.locked{opacity:.42;cursor:default;}
.lc-n{font-size:.64rem;font-weight:600;color:var(--mute);margin-bottom:.12rem;}
.lc-nm{font-family:'Syne',sans-serif;font-size:.85rem;font-weight:700;color:var(--blue-dk);margin-bottom:.12rem;}
.lc-s{font-size:.66rem;color:var(--mute);}
.lc-b{height:3px;background:var(--bdr);border-radius:2px;margin-top:.48rem;}
.lc-bf{height:100%;background:var(--yel);border-radius:2px;transition:width .4s;}

/* ── LEVEL DETAIL ── */
.ld{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);padding:1.05rem;margin-bottom:1.1rem;}
.ld-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:.85rem;flex-wrap:wrap;gap:.4rem;}
.ldbadge{color:#fff;padding:.26rem .7rem;border-radius:6px;font-size:.74rem;font-weight:600;}
.fom-p{background:var(--yel-lt);border:1px solid var(--yel-md);color:var(--yel-dk);
  padding:.18rem .6rem;border-radius:5px;font-size:.67rem;font-weight:600;}
.ep-p{background:var(--blue-lt);color:var(--blue-dk);padding:.18rem .6rem;border-radius:5px;font-size:.67rem;font-weight:600;}
.ms-l{display:flex;flex-direction:column;gap:.38rem;}
.ms{display:flex;align-items:flex-start;gap:.6rem;padding:.55rem .7rem;background:var(--bg);
  border-radius:7px;cursor:pointer;transition:background .14s;}
.ms:hover{background:var(--blue-x);}
.ms.chk{background:var(--green-lt);}
.ms-box{width:18px;height:18px;border:2px solid var(--bdr);border-radius:4px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:.62rem;margin-top:1px;transition:all .18s;}
.ms.chk .ms-box{background:var(--green);border-color:var(--green);color:#fff;}
.ms-body strong{font-size:.8rem;font-weight:600;display:block;line-height:1.32;}
.ms-body small{font-size:.69rem;color:var(--mute);margin-top:1px;display:block;}

/* ── UN-AI-ABLE ── */
.unaible{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);padding:1.05rem;margin-bottom:1.1rem;}
.ir{display:flex;gap:.45rem;align-items:center;margin-top:.48rem;flex-wrap:wrap;}
.ir input{flex:1;min-width:170px;}
.ub-l{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.6rem;}
.ub{background:var(--yel-lt);border:1.5px solid var(--yel-md);color:var(--yel-dk);
  padding:.26rem .65rem;border-radius:6px;font-size:.74rem;font-weight:600;
  display:flex;align-items:center;gap:.3rem;}
.ub button{background:none;border:none;color:var(--yel-dk);font-size:.82rem;padding:0;line-height:1;cursor:pointer;}

/* ── FORM ELEMENTS ── */
input[type=text],input[type=number],input[type=date],textarea,select{
  width:100%;border:1.5px solid var(--bdr);border-radius:var(--r-sm);
  padding:.48rem .76rem;font-size:.82rem;color:var(--txt);background:var(--bg);
  resize:vertical;transition:border .18s;outline:none;}
input[type=text]:focus,input[type=number]:focus,input[type=date]:focus,textarea:focus,select:focus{border-color:var(--blue);}
select{cursor:pointer;}
.btn{background:var(--blue);color:#fff;border:none;padding:.46rem 1rem;border-radius:var(--r-sm);
  font-size:.78rem;font-weight:600;transition:background .18s;}
.btn:hover{background:var(--blue-dk);}
.btn-sm{padding:.32rem .72rem;font-size:.73rem;}
.btn-y{background:var(--yel);color:var(--blue-dk);}
.btn-y:hover{background:var(--yel-dk);color:#fff;}
.btn-g{background:transparent;border:1.5px solid var(--bdr);color:var(--txt);}
.btn-g:hover{border-color:var(--blue);color:var(--blue);}
.btn-red{background:var(--red-lt);border:1.5px solid #F5C6C4;color:var(--red);}
.btn-red:hover{background:var(--red);color:#fff;}

/* ── GRIDS ── */
.rg{display:grid;grid-template-columns:1fr 1fr;gap:.9rem;margin-bottom:1.1rem;}
@media(max-width:600px){.rg{grid-template-columns:1fr;}}
.rc{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);padding:.92rem;}
.rl{font-size:.67rem;font-weight:700;color:var(--blue-dk);text-transform:uppercase;letter-spacing:.5px;margin-bottom:.4rem;}
.chip{background:var(--blue-lt);color:var(--blue-dk);border:none;padding:.25rem .6rem;border-radius:5px;
  font-size:.7rem;font-weight:600;cursor:pointer;margin:.18rem .14rem 0 0;transition:background .15s;}
.chip:hover{background:var(--blue-x);}

/* ── GOAL BOX ── */
.gb{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);padding:.92rem;margin-bottom:1.1rem;}
.gr{display:flex;gap:.45rem;margin-bottom:.45rem;}
.gr input{flex:1;}
.gl{display:flex;flex-direction:column;gap:.32rem;margin-top:.4rem;}
.gi{display:flex;align-items:center;gap:.45rem;padding:.4rem .65rem;background:var(--bg);border-radius:7px;font-size:.79rem;}
.gi.done span{text-decoration:line-through;color:var(--mute);}
.gi input[type=checkbox]{width:15px;height:15px;flex-shrink:0;}
.gi .dx{background:none;border:none;color:var(--mute);font-size:.82rem;cursor:pointer;margin-left:auto;padding:0;}

/* ── QUIZ CTA ── */
.qcta{background:var(--blue-lt);border:1.5px solid var(--blue-x);border-radius:var(--r);
  padding:.9rem 1.05rem;margin-bottom:1.1rem;display:flex;align-items:center;
  justify-content:space-between;gap:.7rem;flex-wrap:wrap;}
.qcta p{font-size:.79rem;color:var(--blue-dk);line-height:1.44;}
.qcta strong{font-size:.86rem;display:block;margin-bottom:.17rem;}

/* ── EPISODES ── */
.eg{display:grid;grid-template-columns:repeat(auto-fill,minmax(222px,1fr));gap:.7rem;margin-bottom:1.1rem;}
.ep{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);
  padding:.82rem .92rem;transition:all .18s;}
.ep:hover{border-color:var(--blue-md);box-shadow:var(--sh);}
.ep-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:.36rem;}
.ep-num{font-size:.66rem;font-weight:600;color:var(--mute);}
.ep-lvl{font-size:.62rem;font-weight:700;padding:.15rem .46rem;border-radius:4px;}
.ep-title{font-size:.78rem;font-weight:600;color:var(--txt);line-height:1.33;margin-bottom:.48rem;}
.ep-desc{font-size:.7rem;color:var(--mute);line-height:1.37;margin-bottom:.48rem;}
.ep-link{display:inline-flex;align-items:center;gap:.26rem;font-size:.72rem;color:var(--blue);font-weight:600;}

/* ── INCOME ── */
.ib{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);padding:1.18rem;margin-bottom:1.1rem;}
.tot{font-family:'Syne',sans-serif;font-size:1.95rem;font-weight:800;color:var(--blue-dk);}
.if{display:flex;gap:.45rem;flex-wrap:wrap;align-items:center;margin-bottom:.7rem;}
.if input[type=text]{flex:2;min-width:144px;}
.if input[type=number]{flex:1;min-width:105px;}
.if input[type=date]{flex:1;min-width:115px;}
.il{display:flex;flex-direction:column;gap:.34rem;}
.ii{display:flex;align-items:center;justify-content:space-between;padding:.46rem .7rem;
  background:var(--bg);border-radius:7px;font-size:.79rem;flex-wrap:wrap;gap:.3rem;}
.ia{font-weight:700;color:var(--green);}
.id-btn{background:none;border:none;color:var(--red);cursor:pointer;font-size:.8rem;}

/* ── TOOLBOX ── */
.tg{display:grid;grid-template-columns:repeat(auto-fill,minmax(248px,1fr));gap:.85rem;}
.tool{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);padding:.92rem;transition:all .18s;}
.tool:hover{border-color:var(--blue-md);box-shadow:var(--sh);}
.tool.featured{border-color:var(--yel-md);background:var(--yel-lt);}
.th{display:flex;align-items:center;gap:.7rem;margin-bottom:.52rem;}
.ti{width:40px;height:40px;border-radius:9px;display:flex;align-items:center;justify-content:center;
  font-family:'Syne',sans-serif;font-weight:800;font-size:.9rem;flex-shrink:0;}
.tn{font-weight:700;font-size:.88rem;}
.tc{font-size:.65rem;color:var(--mute);font-weight:600;text-transform:uppercase;letter-spacing:.4px;}
.td{font-size:.76rem;color:var(--mute);line-height:1.43;margin-bottom:.5rem;}
.tl{display:inline-flex;align-items:center;gap:.26rem;font-size:.76rem;color:var(--blue);font-weight:600;}
.tool-note{font-size:.68rem;color:var(--red);font-weight:600;margin-top:.35rem;}

/* ── STATS ── */
.sg{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:.7rem;margin-bottom:1.1rem;}
.st{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);padding:.8rem;text-align:center;}
.st-n{font-family:'Syne',sans-serif;font-size:1.65rem;font-weight:800;color:var(--blue-dk);}
.st-l{font-size:.66rem;color:var(--mute);font-weight:600;text-transform:uppercase;letter-spacing:.4px;margin-top:.15rem;}

/* ── IDEATION LAB ── */
.idea-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.85rem;margin-bottom:1.1rem;}
.idea-card{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);
  padding:.92rem;transition:all .18s;}
.idea-card:hover{border-color:var(--blue-md);box-shadow:var(--sh);}
.idea-card.selected{border-color:var(--blue);background:var(--blue-lt);}
.ic-icon{font-size:1.5rem;margin-bottom:.4rem;}
.ic-name{font-weight:700;font-size:.88rem;margin-bottom:.25rem;}
.ic-desc{font-size:.75rem;color:var(--mute);line-height:1.42;}
.ic-tag{display:inline-block;font-size:.64rem;font-weight:600;padding:.15rem .48rem;
  border-radius:4px;margin-top:.45rem;}
.idea-canvas{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);padding:1.05rem;margin-bottom:1.1rem;}
.canvas-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:.6rem;margin-top:.7rem;}
.canvas-box{background:var(--bg);border:1px solid var(--bdr);border-radius:var(--r-sm);padding:.6rem;}
.canvas-box label{font-size:.66rem;font-weight:700;color:var(--blue-dk);text-transform:uppercase;letter-spacing:.4px;display:block;margin-bottom:.3rem;}
.canvas-box textarea{font-size:.76rem;height:68px;background:transparent;border:none;outline:none;
  resize:none;width:100%;color:var(--txt);padding:0;}
.canvas-box textarea::placeholder{color:var(--mute);}
.ship-checklist{display:flex;flex-direction:column;gap:.38rem;margin-top:.7rem;}
.ship-item{display:flex;align-items:center;gap:.55rem;padding:.45rem .68rem;
  background:var(--bg);border-radius:7px;font-size:.8rem;cursor:pointer;}
.ship-item.done-s{background:var(--green-lt);}
.ship-box{width:18px;height:18px;border:2px solid var(--bdr);border-radius:4px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:.62rem;transition:all .18s;}
.ship-item.done-s .ship-box{background:var(--green);border-color:var(--green);color:#fff;}

/* ── FP BADGE ── */
.fp{background:linear-gradient(135deg,var(--blue-dk),var(--blue));color:#fff;border-radius:var(--r);
  padding:1.45rem;text-align:center;margin-bottom:1.1rem;display:none;}
.fp h2{font-size:1.25rem;margin:.4rem 0 .18rem;}
.fp p{font-size:.82rem;opacity:.82;}

/* ── SETTINGS ── */
.sett-section{background:var(--surf);border:1.5px solid var(--bdr);border-radius:var(--r);
  padding:1.05rem;margin-bottom:1.1rem;}
.sett-row{display:flex;flex-direction:column;gap:.35rem;margin-bottom:.75rem;}
.sett-row:last-child{margin-bottom:0;}
.sett-label{font-size:.76rem;font-weight:600;color:var(--txt);}
.sett-hint{font-size:.7rem;color:var(--mute);margin-top:.15rem;}
.deg-choice{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:.5rem;margin-top:.4rem;}
.deg-btn{background:var(--bg);border:1.5px solid var(--bdr);border-radius:var(--r-sm);
  padding:.55rem .8rem;font-size:.78rem;font-weight:600;color:var(--txt);text-align:left;
  transition:all .18s;}
.deg-btn.sel{background:var(--blue-lt);border-color:var(--blue);color:var(--blue-dk);}
.deg-btn:hover:not(.sel){border-color:var(--blue-md);}
.mod-list{display:flex;flex-direction:column;gap:.35rem;margin-top:.5rem;}
.mod-item{display:flex;align-items:center;gap:.45rem;padding:.4rem .65rem;
  background:var(--bg);border-radius:7px;font-size:.79rem;}
.mod-item input[type=text]{flex:1;}
.mod-item .del-m{background:none;border:none;color:var(--mute);cursor:pointer;font-size:.82rem;padding:0;}
.add-mod-row{display:flex;gap:.45rem;margin-top:.45rem;}
.add-mod-row input{flex:1;}
.level-mod-map{display:flex;flex-direction:column;gap:.38rem;margin-top:.5rem;}
.lmm-row{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;}
.lmm-label{min-width:100px;font-size:.78rem;font-weight:600;}
.lmm-row select{flex:1;min-width:180px;}
.danger-zone{background:var(--red-lt);border:1.5px solid #F5C6C4;border-radius:var(--r);padding:.9rem;margin-bottom:1.1rem;}
.danger-zone p{font-size:.78rem;color:var(--red);margin-bottom:.55rem;}

/* ── OVERLAY (Quote) ── */
.ov{position:fixed;inset:0;background:rgba(8,25,55,.65);z-index:800;display:none;
  align-items:center;justify-content:center;padding:1rem;}
.ov.show{display:flex;}
.qb{background:var(--surf);border-radius:var(--r);padding:1.65rem;max-width:450px;
  width:100%;text-align:center;box-shadow:var(--sh);}
.qp{font-size:.68rem;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;margin-bottom:.45rem;}
.qt{font-size:.96rem;font-style:italic;line-height:1.63;color:var(--txt);margin-bottom:.7rem;}
.qe{font-size:.69rem;color:var(--mute);}
.qbtns{display:flex;gap:.45rem;justify-content:center;margin-top:.9rem;flex-wrap:wrap;}

#cc{position:fixed;inset:0;pointer-events:none;z-index:9999;display:none;}
.hr{border:none;border-top:1px solid var(--bdr);margin:.9rem 0;}
.mt5{margin-top:.5rem;}.mt1{margin-top:1rem;}.mb5{margin-bottom:.5rem;}.mb1{margin-bottom:.95rem;}
.sm{font-size:.79rem;}.mute{color:var(--mute);}.it{font-style:italic;}
.row{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap;}
.badge{display:inline-block;padding:.16rem .52rem;border-radius:4px;font-size:.68rem;font-weight:600;}
.b-blue{background:var(--blue-lt);color:var(--blue-dk);}
.b-yel{background:var(--yel-lt);color:var(--yel-dk);}
.b-grn{background:var(--green-lt);color:var(--green);}
</style>
</head>
<body>
<canvas id="cc"></canvas>

<!-- QUOTE OVERLAY -->
<div class="ov" id="qOv">
