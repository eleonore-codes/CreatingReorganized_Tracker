  }).join('');
}
function togShip(i){if(!S.shipDone)S.shipDone={};S.shipDone[i]=!S.shipDone[i];sv();rShip();}
function addShip(){
  const v=document.getElementById('shipIn').value.trim();if(!v)return;
  if(!S.shipCustom)S.shipCustom=[];
  S.shipCustom.push(v);document.getElementById('shipIn').value='';sv();rShip();
}
function addIdea(){
  const v=document.getElementById('ideaIn').value.trim();if(!v)return;
  if(!S.ideaLog)S.ideaLog=[];
  S.ideaLog.unshift({t:v,id:Date.now(),date:new Date().toISOString().slice(0,10)});
  document.getElementById('ideaIn').value='';sv();rIdeaLog();
}
function rmIdea(id){S.ideaLog=S.ideaLog.filter(i=>i.id!==id);sv();rIdeaLog();}
function rIdeaLog(){
  const el=document.getElementById('ideaLog');
  if(!S.ideaLog||S.ideaLog.length===0){el.innerHTML='<p class="sm mute" style="padding:.3rem 0;">No ideas yet. Quantity over quality — log everything.</p>';return;}
  el.innerHTML=S.ideaLog.map((i,idx)=>
    `<div class="gi">
      <span style="color:var(--mute);font-size:.73rem;flex-shrink:0;">#${S.ideaLog.length-idx}</span>
      <span style="flex:1;">${i.t}</span>
      <span style="color:var(--mute);font-size:.7rem;">${i.date}</span>
      <button class="dx" onclick="rmIdea(${i.id})">×</button>
    </div>`
  ).join('');
}

/* ════ OVERVIEW ════ */
function rov(){
  const totMs=LVS.reduce((a,lv)=>a+lv.ms.length,0);
  const dMs=Object.values(S.chk).filter(Boolean).length;
  const totInc=S.inc.reduce((a,i)=>a+i.amt,0);
  const lvsDone=LVS.filter(lv=>lpct(lv.id)===100).length;
  const ideaCount=(S.ideaLog||[]).length;
  document.getElementById('stG').innerHTML=[
    {n:S.lv,l:'Current Level'},{n:dMs+'/'+totMs,l:'Milestones Done'},
    {n:lvsDone+'/6',l:'Levels Complete'},{n:S.ua.length,l:'Un-AI-able Badges'},
    {n:ideaCount,l:'Ideas Logged'},{n:'€'+totInc.toFixed(0),l:'Income Logged'},
  ].map(s=>`<div class="st"><div class="st-n">${s.n}</div><div class="st-l">${s.l}</div></div>`).join('');

  document.getElementById('fomT').innerHTML=LVS.map(lv=>`
    <div style="display:flex;align-items:center;gap:.6rem;padding:.36rem .56rem;background:var(--bg);border-radius:6px;flex-wrap:wrap;">
      <span style="background:${lv.lt};color:${lv.col};padding:.16rem .5rem;border-radius:4px;font-size:.68rem;font-weight:600;min-width:66px;text-align:center;flex-shrink:0;">Lvl ${lv.id}: ${lv.name}</span>
      <span style="font-size:.79rem;font-weight:600;">${getModFor(lv.id)}</span>
      <span style="font-size:.71rem;color:var(--mute);margin-left:auto;">${lv.ep}</span>
    </div>`).join('');

  if(S.wins)document.getElementById('wTx').value=S.wins;
  if(S.lessons)document.getElementById('lTx').value=S.lessons;
}

/* ════ SETTINGS ════ */
function rSettings(){
  // Degree picker
  document.getElementById('degGrid').innerHTML=DEGREES.map(d=>
    `<button class="deg-btn${S.degree===d.id?' sel':''}" onclick="selDeg('${d.id}')">${d.label}</button>`
  ).join('');
  // Uni
  if(S.uni)document.getElementById('uniIn').value=S.uni;
  // Name
  if(S.name)document.getElementById('nameIn').value=S.name;
  // Modules list
  rModList();
  // Level module map
  rLvlModMap();
}
function selDeg(id){S.degree=id;sv();
  document.querySelectorAll('.deg-btn').forEach(b=>b.classList.toggle('sel',b.textContent===DEGREES.find(d=>d.id===id)?.label));
  rHero();rDet();
}
function saveUni(){S.uni=document.getElementById('uniIn').value;sv();rHero();}
function saveName(){S.name=document.getElementById('nameIn').value;sv();rHero();}
function addMod(){
  const v=document.getElementById('modIn').value.trim();if(!v)return;
  if(!S.modules)S.modules=[];
  S.modules.push(v);document.getElementById('modIn').value='';sv();rModList();rLvlModMap();
}
function rmMod(i){S.modules.splice(i,1);sv();rModList();rLvlModMap();}
function rModList(){
  document.getElementById('modList').innerHTML=(S.modules||[]).length?
    S.modules.map((m,i)=>`<div class="mod-item"><span style="flex:1;font-size:.79rem;">${m}</span>
      <button class="del-m" onclick="rmMod(${i})">× Remove</button></div>`).join('')
    :'<p class="sm mute" style="padding:.3rem 0;">No modules added yet. Add your semester modules above.</p>';
}
function rLvlModMap(){
  const mods=S.modules||[];
  if(mods.length===0){
    document.getElementById('lvlModMap').innerHTML='<p class="sm mute">Add at least one module above to start mapping.</p>';return;
  }
  document.getElementById('lvlModMap').innerHTML=LVS.map(lv=>`
    <div class="lmm-row">
      <span class="lmm-label" style="color:${lv.col};font-size:.76rem;">Lvl ${lv.id}: ${lv.name}</span>
      <select onchange="saveLvMod(${lv.id},this.value)">
        <option value="">— Default: ${lv.defMod} —</option>
        ${mods.map(m=>`<option value="${m}"${S.lvMods[lv.id]===m?' selected':''}>${m}</option>`).join('')}
      </select>
    </div>`).join('');
}
function saveLvMod(id,val){if(!S.lvMods)S.lvMods={};S.lvMods[id]=val;sv();rDet();}

function resetProgress(){
  if(!confirm('Reset all progress (milestones, income, reflections, badges)? Module settings will be kept.'))return;
  const kept={degree:S.degree,uni:S.uni,name:S.name,modules:S.modules,lvMods:S.lvMods};
  S=Object.assign(dfS(),kept);sv();init();alert('Progress reset. Your academic profile is saved.');}
function resetAll(){
  if(!confirm('Reset EVERYTHING including all settings? This cannot be undone.'))return;
  S=dfS();sv();init();alert('App fully reset.');}

/* ════ QUOTES ════ */
let qI=0;
function showQ(){qI=Math.floor(Math.random()*QS.length);rQ();document.getElementById('qOv').classList.add('show');}
function nxtQ(){qI=(qI+1)%QS.length;rQ();}
function closeQ(){document.getElementById('qOv').classList.remove('show');}
function rQ(){const q=QS[qI];document.getElementById('qT').textContent='"'+q.t+'"';document.getElementById('qE').textContent='— Prof. Dr. E, '+q.e;}

/* ════ INIT ════ */
function init(){
  rHero();rLvls();rDet();rPrm();rUA();rGl();rInc();rEps();rTools();rIdeation();
  document.getElementById('iDt').value=new Date().toISOString().slice(0,10);
  if(S.inc.length>0&&S.lv===6)document.getElementById('fpB').style.display='block';
}
init();
</script>
</body>
</html>
