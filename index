/* ════ CELEBRATE ════ */
function celebrate(){
  document.getElementById('fpB').style.display='block';
  const cv=document.getElementById('cc');cv.style.display='block';
  const ctx=cv.getContext('2d');cv.width=window.innerWidth;cv.height=window.innerHeight;
  const ps=[];
  for(let i=0;i<170;i++)ps.push({x:Math.random()*cv.width,y:Math.random()*cv.height-cv.height,
    r:Math.random()*6+3,c:['#F5C416','#1558A8','#ffffff','#0B3D7A','#2A7DD4'][Math.floor(Math.random()*5)],
    d:Math.random()*2.2+1,s:Math.random()*2-1});
  let f=0;(function draw(){
    ctx.clearRect(0,0,cv.width,cv.height);
    ps.forEach(p=>{ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,2*Math.PI);ctx.fillStyle=p.c;ctx.fill();p.y+=p.d;p.x+=p.s;});
    f++;if(f<230)requestAnimationFrame(draw);else{ctx.clearRect(0,0,cv.width,cv.height);cv.style.display='none';}
  })();
}

